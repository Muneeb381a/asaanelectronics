{
  "buildCommand": "pnpm vercel-build",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/audit/cleanup", "schedule": "0 2 * * *" }
  ]
}
