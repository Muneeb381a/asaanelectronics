{
  "buildCommand": "pnpm vercel-build",
  "installCommand": "cd ../.. && NODE_ENV=development pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/audit/cleanup", "schedule": "0 2 * * *" },
    { "path": "/api/backups/cron", "schedule": "0 3 * * *" }
  ]
}
